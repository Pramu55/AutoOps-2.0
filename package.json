{
  "name": "autoops",
  "version": "3.0.0",
  "private": true,
  "description": "AutoOps 3.0 — AI-native DevOps Control Plane",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3",
      "next@15.5.21>postcss": "8.5.26",
      "next@15.5.21>sharp": "0.35.0",
      "ws": "8.21.3",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "ip-address": "10.7.0",
      "socket.io-parser": "4.2.7",
      "body-parser": "1.20.6",
      "qs": "6.15.3",
      "brace-expansion@1.1.14": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9",
      "browserslist": "4.28.8",
      "postcss-selector-parser": "6.1.4"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @autoops/database run generate",
    "db:migrate": "pnpm --filter @autoops/database run migrate:dev",
    "db:reset": "pnpm --filter @autoops/database run reset",
    "db:seed": "pnpm --filter @autoops/database run seed",
    "check:release": "powershell -ExecutionPolicy Bypass -File scripts/check-release.ps1",
    "check:release:linux": "bash scripts/check-release.sh",
    "check:secrets": "powershell -ExecutionPolicy Bypass -File scripts/scan-secrets.ps1",
    "check:secrets:linux": "bash scripts/scan-secrets.sh",
    "test:mounted-secret-delivery": "powershell -ExecutionPolicy Bypass -File scripts/test-mounted-secret-delivery.ps1",
    "test:mounted-secret-transfer": "powershell -ExecutionPolicy Bypass -File scripts/test-mounted-secret-transfer.ps1",
    "test:secret-rotation-recovery": "powershell -ExecutionPolicy Bypass -File scripts/test-secret-rotation-recovery.ps1",
    "test:rotation-authority": "powershell -ExecutionPolicy Bypass -File scripts/test-rotation-authority.ps1",
    "test:secret-rotation-operation-state": "powershell -ExecutionPolicy Bypass -File scripts/update-secret-rotation-operation-state.ps1 -RunSelfTest",
    "test:secret-rotation-acceptance-finalizer": "powershell -ExecutionPolicy Bypass -File scripts/confirm-secret-rotation-runtime.ps1 -RunSelfTest",
    "test:file-mode-image-provenance": "powershell -ExecutionPolicy Bypass -File scripts/validate-file-mode-image-provenance.ps1 -RunSelfTest",
    "check:container-hardening": "node scripts/validate-container-hardening.mjs",
    "check:terraform-foundation": "node scripts/validate-terraform-foundation.mjs",
    "check:aws-proof-infrastructure": "node scripts/validate-aws-proof-infrastructure.mjs",
    "check:terraform-init-readiness": "node scripts/validate-terraform-init-readiness.mjs",
    "check:terraform-runtime-approval": "node scripts/validate-terraform-runtime-approval.mjs",
    "check:terraform-plan-readiness": "node scripts/validate-terraform-plan-readiness.mjs",
    "check:aws-identity-credential-readiness": "node scripts/validate-aws-identity-credential-readiness.mjs",
    "docker:dev": "docker compose up --build",
    "docker:dev:detached": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@prisma/client": "^5.20.0",
    "@types/node": "^20.14.10",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "turbo": "2.9.14",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
